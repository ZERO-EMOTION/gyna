# Gyna — .env.example
# Copy to .env and fill in your credentials

# MetaTrader 5
MT5_LOGIN=your_account_number
MT5_PASSWORD=your_password
MT5_SERVER=ICMarketsSC-Demo

# LLM provider: anthropic | groq | ollama (default: anthropic)
# Fallback chain: chosen provider -> groq -> anthropic -> local deterministic
LLM_PROVIDER=anthropic

# Anthropic (Claude brain)
ANTHROPIC_API_KEY=sk-ant-...
# MODEL=claude-sonnet-5

# Optional: Groq fallback (free tier)
# GROQ_API_KEY=gsk_...
# GROQ_MODEL=llama-3.3-70b-versatile

# Optional: local Ollama (no API cost)
# OLLAMA_URL=http://localhost:11434
# OLLAMA_MODEL=qwen2.5:14b

# Optional: Telegram notifications
TELEGRAM_TOKEN=your_bot_token
TELEGRAM_CHAT_ID=your_chat_id

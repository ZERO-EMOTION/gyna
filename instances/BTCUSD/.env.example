# Gyna instance — BTCUSD (crypto, 24/7)
# Copy to .env in this folder. This instance keeps its OWN databases,
# logs, and learning state here — fully isolated from other symbols.
SYMBOL=BTCUSD

# Master safety toggle: on (default) | off — off disables ALL protective
# filters (spread, cooldown, kill hours, toxic penalty, loss-streak,
# EQD, daily breaker, friction, margin). Testing only.
SAFETY_FILTERS=on

# MetaTrader 5
MT5_LOGIN=your_account_number
MT5_PASSWORD=your_password
MT5_SERVER=ICMarketsSC-Demo

# LLM provider: anthropic | groq | ollama
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=sk-ant-...
# MODEL=claude-sonnet-5
# GROQ_API_KEY=gsk_...
# OLLAMA_URL=http://localhost:11434
# OLLAMA_MODEL=qwen2.5:14b

# Optional: Telegram notifications
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=
